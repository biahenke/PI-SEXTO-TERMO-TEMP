# Configurações do MongoDB (para consulta_mongo.py)
MONGO_URI=mongodb://root:<SENHA>@<HOST>:27017/?authSource=admin
MONGO_DB=iot
MONGO_COLLECTION=sensores

# Configurações do MariaDB (para consulta.py)
MARIADB_HOST=<HOST>
MARIADB_PORT=3306
MARIADB_USER=root
MARIADB_PASSWORD=<SENHA>
MARIADB_DATABASE=fatec_iot
